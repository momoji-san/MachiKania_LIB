FIELD PRIVATE AD,BUF

METHOD INIT
DIM BUF(256)
AD=ARGS(1)
IF ARGS(3) = 1 THEN
  I2CWRITE AD,$00,$C8,$A1,$DA,$02,$A8,$1F,$D3,$00,$40,$A6,$8D,$14
ELSE
  I2CWRITE AD,$00,$C8,$A1,$A8,$3F,$D3,$00,$40,$A6,$8D,$14
ENDIF
GOSUB PUTALL
IF ARGS(2) = 1 THEN
  I2CWRITE AD,$00,$A7,$AF
ELSE
  I2CWRITE AD,$80,$AF
ENDIF
RETURN

LABEL PUTALL
 VAR M
 FOR M=0 TO 7
  I2CWRITE AD,$00,$B0+M,$10,$00
  I2CWRITEDATA AD,BUF+M*128,128,$40
 NEXT
RETURN

METHOD PRTXT
 VAR X,Y,S,P,I,J,D
 X=ARGS(1):Y=ARGS(2):S=ARGS(3)
 DO
  IF PEEK(S)=0 THEN BREAK
  P=SYSTEM(103)+PEEK(S)*8
  FOR I=0 TO 7
   D=PEEK(P)
   FOR J=0 TO 7
    IF D AND $80 THEN
     GOSUB SETP,X+J,Y+I,1
    ELSE
     GOSUB SETP,X+J,Y+I,0
    ENDIF
    D=D<<1
   NEXT
   P=P+1
  NEXT
  S=S+1:X=X+8
 LOOP
RETURN

METHOD SETP
 VAR X,Y,P,A
 X=ARGS(1):Y=ARGS(2):P=ARGS(3)
 IF X<0 OR X>=128 THEN RETURN
 IF Y<0 OR Y>= 64 THEN RETURN
 A=BUF+(Y*16 AND $380)+X
 IF P=1 THEN
  POKE A,PEEK(A) OR (1<<(Y AND 7))
 ELSE
  POKE A,PEEK(A) AND ((1<<(Y AND 7)) XOR $FF)
 ENDIF
 I2CWRITE AD,$00,$B0+(Y>>3),$10+(X>>4),X AND $0F
 I2CWRITE AD,$40,PEEK(A)
RETURN

METHOD PRTKNJ
 VAR X,Y,S$,Q,W,K
 X=ARGS(1):Y=ARGS(2):S$=ARGS$(3)
 K=NEW(CKNJ8,"UTF-8")
 Q=K.GETBMP(S$,1,0)
 W=K.GETDW()
 FOR I=0 TO W-1
  FOR J=0 TO 7
   IF PEEK(Q+I+J*W) THEN
     CALL D.SETP(X+I,Y+J,1)
    ELSE
     CALL D.SETP(X+I,Y+J,0)
    ENDIF
  NEXT
 NEXT
 DELETE Q
RETURN
